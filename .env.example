# Copy to .env and fill in. .env is ignored by git, so your token never leaves the server.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: your home server ID. Only used to clean up old server-only command copies.
GUILD_ID=

# Optional: channel ID for the automatic daily gold post. Leave empty to disable.
DAILY_CHANNEL_ID=

# Optional: channel ID for balance-patch alerts (defaults to DAILY_CHANNEL_ID).
PATCH_CHANNEL_ID=
